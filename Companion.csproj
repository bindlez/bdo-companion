<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>companion.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);desktop/**;artifacts/**</DefaultItemExcludes>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="VERSION" LogicalName="Companion.VERSION" />
  </ItemGroup>
</Project>
